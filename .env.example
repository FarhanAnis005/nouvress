# Supabase PostgreSQL Connection String
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Example (Transaction pooler, port 6543):
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or Direct (port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# Payload Secret (Any secure string, 32+ characters)
PAYLOAD_SECRET=nouvress-student-press-secret-key-change-in-production-1234567890

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Editorial Contact (Optional display on /contact)
EDITORIAL_CONTACT=
