# Supabase PostgreSQL Connection String (Transaction Pooler for Vercel & Serverless)
# Get from: Supabase Dashboard -> Settings -> Database -> Connection pooling -> Transaction mode (URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Payload Secret (Any secure string, 32+ characters)
PAYLOAD_SECRET=nouvres-student-press-secret-key-change-in-production-1234567890

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Editorial Contact (Optional display on /contact)
EDITORIAL_CONTACT=

# Initial Admin Dashboard Credentials (used for initial setup/seed)
ADMIN_EMAIL=editor@nouvres.org
ADMIN_PASSWORD=your-secure-admin-password-here
