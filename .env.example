# Supabase PostgreSQL Connection String
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Payload Secret (Any secure string, 32+ characters)
PAYLOAD_SECRET=nouvress-student-press-secret-key-change-in-production-1234567890

# Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Editorial Contact (Optional display on /contact)
EDITORIAL_CONTACT=

# Initial Admin Dashboard Credentials (used for initial setup/seed)
ADMIN_EMAIL=editor@nouvress.org
ADMIN_PASSWORD=your-secure-admin-password-here
